# VibeLoad Media Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Allowed CORS Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["https://vibeload-web.vercel.app","http://localhost:5173","http://localhost:4173"]

# Storage & Temp directories
STORAGE_DIR=./storage
MAX_STORAGE_MB=5120
STORAGE_TTL_SECONDS=1800

# Rate limits & Concurrent limits
MAX_CONCURRENT_JOBS_PER_IP=3
MAX_CONCURRENT_JOBS_TOTAL=10
RATE_LIMIT_PER_MINUTE=30

# Max download filesize (in MB)
MAX_FILE_SIZE_MB=500

# Network timeout (seconds)
SOCKET_TIMEOUT=30
